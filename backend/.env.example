# ─────────────────────────────────────────────────────────────────────────────
# ClipHub-v2 — Minimal Bootstrap Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# NOTE: All operational settings (API Keys, 9router, Gemini, Groq, Pexels,
# Remotion, B-Roll tuning, Reframe vision, limits, etc.) are stored dynamically
# in the database (`system_settings` table) and managed live via the Web Panel
# (Settings -> Database & Env Config) with Role-Based Access Control (RBAC).
#
# Only the bootstrap variables below are required in `.env`:
# ─────────────────────────────────────────────────────────────────────────────

# ─── Environment & Network Bootstrap ─────────────────────────────────────────
PIPELINE_ENV=local
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://cliperhub-tunnel.trycloudflare.com
AUTOCLIPER_PUBLIC_URL=https://cliperhub-tunnel.trycloudflare.com

# ─── Database (SQLite / Postgres) ────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///data/autoclip.db

# ─── Auth / Machine Cryptography Keys ────────────────────────────────────────
JWT_SECRET_KEY=generate-a-64-char-random-hex-string
JWT_REFRESH_SECRET_KEY=generate-another-64-char-random-hex-string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Initial Superadmin Bootstrap Seed ───────────────────────────────────────
SUPERADMIN_EMAIL=admin@autocliper.com
SUPERADMIN_PASSWORD=Admin@2024!Secure
