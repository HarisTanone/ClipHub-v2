# AutoCliper Hermes secrets — LOCAL == PRODUCTION
# Copy to $HERMES_HOME/.env (default ~/.hermes/.env) via:
#   scripts/sync-hermes-config.sh
# Never commit the real .env.

# 9router OpenAI-compatible gateway (same on Mac + server)
# Leave empty if local 9router does not require auth.
OPENAI_API_KEY=
NINE_ROUTER_API_KEY=
OPENAI_BASE_URL=http://127.0.0.1:20128/v1

# Optional direct providers (only if ALLOW_DIRECT / fallback enabled)
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# GOOGLE_API_KEY=

# AutoCliper API Auth (optional: inherits from backend/.env automatically)
AUTOCLIPER_API_URL=http://127.0.0.1:8000/api
# AUTOCLIPER_EMAIL=
# AUTOCLIPER_PASSWORD=


